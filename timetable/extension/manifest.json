{
  "manifest_version": 3,
  "name": "時間割サイドパネル",
  "version": "1.0.0",
  "description": "新しいタブを開いているときだけ、サイドパネルに時間割を出す。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "時間割を開く（新しいタブのとき）"
  }
}
